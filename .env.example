# Gemini AI Credentials
GEMINI_API_KEY=
GEMINI_WORKOUT_MODEL=gemini-2.5-flash
GEMINI_NUTRITION_MODEL=gemini-2.5-flash

# Application Environment
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database Configuration (SQLite locally, PostgreSQL in Production)
DATABASE_URL=sqlite:///./fitbuddy.db

# JWT Security
SECRET_KEY=fitbuddy-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe SaaS Monetization (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_pro_monthly
FREE_TIER_MONTHLY_LIMIT=3

# Production Sentry Error Monitoring (Optional)
SENTRY_DSN=
